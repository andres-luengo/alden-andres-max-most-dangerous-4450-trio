
@article{ajp_apparatus,
	title = {Entangled photon apparatus for the undergraduate laboratory},
	volume = {70},
	issn = {0002-9505},
	url = {https://doi.org/10.1119/1.1498859},
	doi = {10.1119/1.1498859},
	abstract = {We present detailed instructions for constructing and operating an apparatus to produce and detect polarization-entangled photons. The source operates by type I spontaneous parametric downconversion in a two-crystal geometry. Photons are detected in coincidence by single-photon counting modules and show strong angular and polarization correlations. We observe more than 100 entangled photon pairs per second. A test of a Bell inequality can be performed in an afternoon.},
	number = {9},
	urldate = {2026-01-27},
	journal = {American Journal of Physics},
	author = {Dehlinger, Dietrich and Mitchell, M. W.},
	month = sep,
	year = {2002},
	pages = {898--902},
	file = {Submitted Version:/home/alden/Zotero/storage/RSG4XC5I/Dehlinger and Mitchell - 2002 - Entangled photon apparatus for the undergraduate laboratory.pdf:application/pdf},
}

@article{ajp_theory,
	title = {Entangled photons, nonlocality, and {Bell} inequalities in the undergraduate laboratory},
	volume = {70},
	issn = {0002-9505},
	url = {https://doi.org/10.1119/1.1498860},
	doi = {10.1119/1.1498860},
	abstract = {We use polarization-entangled photon pairs to demonstrate quantum nonlocality in an experiment suitable for advanced undergraduates. The photons are produced by spontaneous parametric downconversion using a violet diode laser and two nonlinear crystals. The polarization state of the photons is tunable. Using an entangled state analogous to that described in the Einstein–Podolsky–Rosen paradox, we demonstrate strong polarization correlations of the entangled photons. Bell’s idea of a hidden variable theory is presented by way of an example and compared to the quantum prediction. A test of the Clauser, Horne, Shimony, and Holt version of the Bell inequality finds S=2.307±0.035, in clear contradiction of hidden variable theories. The experiments described can be performed in an afternoon.},
	number = {9},
	urldate = {2026-01-29},
	journal = {American Journal of Physics},
	author = {Dehlinger, Dietrich and Mitchell, M. W.},
	month = sep,
	year = {2002},
	pages = {903--910},
	file = {Snapshot:/home/alden/Zotero/storage/VI4FFQLQ/1.html:text/html;Submitted Version:/home/alden/Zotero/storage/8R3GAIWG/Dehlinger and Mitchell - 2002 - Entangled photons, nonlocality, and Bell inequalities in the undergraduate laboratory.pdf:application/pdf},
}

@article{bell_quantum,
	title = {Testing a {Bell} {Inequality} with a {Remote} {Quantum} {Processor}},
	volume = {61},
	issn = {0031-921X},
	url = {https://doi.org/10.1119/5.0069073},
	doi = {10.1119/5.0069073},
	abstract = {IBM Quantum offers free remote access to real quantum processors. One of the many
experiments now accessible to all students is a test of Bell inequalities. This experiment
introduces the rigorous mysteries that physicists have grappled with for a century. Using
IBM Quantum to test Bell inequalities is not new. However, we are unaware of any single
reference, appropriate for introductory students, that contains (1) the derivation of a
Bell inequality, (2) the derivation of the corresponding quantum prediction, and (3)
instructions for carrying out the experiment with IBM Quantum.},
	number = {3},
	urldate = {2026-01-29},
	journal = {The Physics Teacher},
	author = {Brody, Jed and Avram, Robert},
	month = mar,
	year = {2023},
	pages = {218--221},
	file = {Snapshot:/home/alden/Zotero/storage/7S4XWK8B/5.html:text/html;Submitted Version:/home/alden/Zotero/storage/C9EF5E69/Brody and Avram - 2023 - Testing a Bell Inequality with a Remote Quantum Processor.pdf:application/pdf},
}

